{
  "name": "@local/dsh-memory-library",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Per-workspace memory library: readable cards, a rebuildable catalog, active recall, optional shared files, and continuous forgetting.",
  "license": "MIT",
  "author": "wafernm-crypto",
  "homepage": "https://github.com/wafernm-crypto/dsh-memory-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wafernm-crypto/dsh-memory-library.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "memory-library",
    "context",
    "forgetting-curve"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3",
    "node": ">=20"
  },
  "main": "index.js",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
